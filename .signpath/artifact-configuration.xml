<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración del artefacto para SignPath.
  Copia este contenido en SignPath → proyecto "pdfgestor" → Artifact Configurations.
  El artefacto que sube GitHub Actions es un zip con los dos ejecutables en la raíz.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PdfGestor.exe" product-name="PDF Gestor">
      <authenticode-sign />
    </pe-file>
    <pe-file path="pdfgestor-cli.exe" product-name="PDF Gestor">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
